int echo(int x){
    return x * 100;
}

int testRet(){
    int x = 20;
    {
        int x = echo(30);
    }
    return x;
}

int testRet2(){
    int x = echo(20);
    {
        int x = 30;
    }
    return x;
}

int main(){
    // testing about constant folding and so
    int x = echo(20);
    if(1)
        int x = 50;
    

    return x; // ?
}