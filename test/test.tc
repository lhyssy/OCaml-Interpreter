int test1_1(){
    int ans = 120;
    if(echo(114)){
        ans = -ans;
    }
    return ans;
}

int test1_2(){
    int ans = 0;
    if(echo(114)){
        ans = 114;
    }
    else{
        ans = 514;
    }
    return ans;
}

int test1_3(){
    int ans0 = 0;
    int ans1 = 1;
    int ans2 = 2;
    int ans3 = 3;
    if(echo(114)){
        ans1 = 114;
        ans3 = 514;
    }
    else if(echo(514)){
        ans1 = 514;
        ans2 = 114;
    }
    else{
        ans3 = 114;
        ans2 = 514;
    }
    return ans0 + ans1 + ans2 + ans3;
}

