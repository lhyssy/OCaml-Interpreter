int count(int x, int y){
    int lines = 0;
    int blocks = 0;
    int i = 0;
    while(i < x){
        i = i + 1;
		int j = 0;
		if(i == 1) continue;
        while(j < y){
            j = j + 1;
            if(j == 2) continue;
            blocks = blocks + 1;
        }
        lines = lines + 1;
    }

    return blocks * lines;
}

int main(){
    return count(5, 5);
}