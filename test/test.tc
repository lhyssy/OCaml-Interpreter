int main(){
    // test the folding
    int x = 1;
    int y = 2;
    int z = 3;
    {
        x = 1;
        {
            z = 3;
            {
                {
                    x = 5;
                    z = z + x;
                }
            }
            y = y - z;
        }
        y = y + x;
    }

    return x + y + z;
}