int main() {
  /* 测试常量折叠 */
  int a = 10 + 20;          /* 应该编译为 li x, 30 */
  int b = 5 * 4;            /* 应该编译为 li x, 20 */
  int c = 100 / 4;          /* 应该编译为 li x, 25 */
  
  /* 测试乘以2的幂次被转为位移 */
  int d = a * 2;            /* 应该编译为 slli x, y, 1 */
  int e = a * 4;            /* 应该编译为 slli x, y, 2 */
  int f = a * 8;            /* 应该编译为 slli x, y, 3 */
  
  /* 测试除以2的幂次被转为位移 */
  int g = a / 2;            /* 应该编译为 srli x, y, 1 */
  int h = a / 4;            /* 应该编译为 srli x, y, 2 */
  int i = a / 8;            /* 应该编译为 srli x, y, 3 */
  
  /* 测试其他代数优化 */
  int j = a + 0;            /* 应该直接使用a的值 */
  int k = a * 1;            /* 应该直接使用a的值 */
  int l = a * 0;            /* 应该编译为 li x, 0 */
  int m = a / 1;            /* 应该直接使用a的值 */
  
  return j + k + l + m;     /* 测试表达式的组合 */
} 