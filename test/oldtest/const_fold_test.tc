// test1：scope shadow的测试
int test1(){
    int x = 1;
    {
        int x = 2;
        x = x + 1;
    }
    return x;
}

// test2：scope进一步测试
int test2(){
    int x = 3;
    int y = 5;
    {
        int x = 4;
        x = x + 1; // 取自内部的x
        y = y + 1; // 取自外部的y
    }
    return x * y;
}

// test3：判断语句内外部的测试
int test3(int x, int y, int z){
    int temp = 5;   // 判断外的常量
    int val = 0;    // 判断外的变量
    if(x < y){
        int alpha = 2;
        val = x + y - alpha;
    }
    else if(y < z){
        val = y + z;
    }
    else if(z < x){
        val = temp * (x + y + z);
    }
    else{
        val = 3 * temp;
    }
    return val + temp;
}


// test4：对于循环内外部的测试
// 现在知道为什么原来的代码导入的是空map了
int test4(int loop_times){
    int i = 0;
    int step = 2; // 在循环外定义的常量
    int val = 0; // 在循环外定义的变量
    while(i < loop_times){
        int salt = 1; // 循环内定义的常量
        val = val + step + salt;
        i = i + 1;
    }
    return val;
}

// test5: T17的expr7测试（？
int is_prime(int n){
    if (n <= 1)
    {
        return 0;
    }
    if (n <= 3)
    {
        return 1;
    }
    if (n % 2 == 0 || n % 3 == 0)
    {
        return 0;
    }

    int i = 5;
    while (i * i <= n)
    {
        if (n % i == 0 || n % (i + 2) == 0)
        {
            return 0;
        }
        i = i + 6;
    }
    return 1;
}

int test5(){
    int n1 = 42;
    int n2 = 56;
    int n3 = 87;

    int expr7 = 0;
    if (is_prime(n1))
    {
        if (is_prime(n2))
        {
            expr7 = n1 * n2;
        }
        else if (is_prime(n3))
        {
            expr7 = n1 * n3;
        }
        else
        {
            expr7 = n1;
        }
    }
    else if (is_prime(n2))
    {
        if (is_prime(n3))
        {
            expr7 = n2 * n3;
        }
        else
        {
            expr7 = n2;
        }
    }
    else if (is_prime(n3))
    {
        expr7 = n3;
    }
    else
    {
        expr7 = n1 + n2 + n3;
    }

    return expr7;
}

// test6：多层block
int test6(){
    int x = 5;
    {
        int x = x + 1; // 应访问外层x=5，结果为6
        {
            int x = x + 1; // 应访问中层x=6，结果为7
        }
    }
    return x; // 必须返回5
}

int test7() {
  int x = 10;          // 外层常量
  while(x > 0) {       // 条件可折叠为真
    int y = x * 2;     // 应优化为y=20
    {
      int x = 5;       // 遮蔽外层x
      y = x + 1;       // 优化为y=6
    }
    x = x - y;         // 破坏循环条件常量性
  }
  return x;
}


int main(){
    return test1() + test2() + test3(27,28,29) + test4(25) + test5();
}